# TypeSafe Jev 深度判断（https://docs.typesafe.ai，可选——没有 key 时规则监控照常工作）
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# 飞书推送目标用户 openId（lark-cli auth status 可查；需本机安装并登录 lark-cli）。
# Codex cycle 用此通道发送飞书；Slack 使用 Codex connector，不在此处保存 token 或用户资料。
LARK_USER_OPEN_ID=
# ===== 微信推送通道（任选其一，填了即启用）=====
# Server酱: https://sct.ftqq.com 微信扫码拿 SendKey（免费5条/天）
SERVERCHAN_SENDKEY=
# PushPlus: https://www.pushplus.plus 拿 token
PUSHPLUS_TOKEN=
# 企业微信群机器人 webhook（免费无限制，消息在企业微信App里看）
WECOM_WEBHOOK_URL=
# WxPusher: appToken + UID
WXPUSHER_APP_TOKEN=
WXPUSHER_UID=
